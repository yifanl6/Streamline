STREAMLINE_ADMIN_TOKEN=replace-with-a-random-admin-token
# Optional for a quick local demo. Generate a persistent Ed25519 key with npm run coordination:keygen.
STREAMLINE_SIGNING_KEY=
# Hosting platforms can instead supply a generated base64-encoded 32-byte seed.
STREAMLINE_SIGNING_SEED=
PORT=4200

# Public NEAR configuration. Keep the DAO and RPC on the same network.
SPUTNIK_DAO_ID=your-dao.sputnik-dao.near
NEAR_RPC_URL=https://rpc.mainnet.near.org

# Secret: place the real value only in .env or a deployment secret manager.
NEARAI_CLOUD_API_KEY=replace-with-a-new-near-ai-key
NEAR_AI_MODEL=z-ai/glm-5.3-flash
