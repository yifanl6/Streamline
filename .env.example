# Coordination API. Generate a signing key with: npm run coordination:keygen
STREAMLINE_ADMIN_TOKEN=replace-with-a-long-random-value
STREAMLINE_SIGNING_KEY=replace-with-generated-pkcs8-key
PORT=4200

# Existing Sputnik DAO/Trezu treasury. The backend only reads it; wallet clients sign actions.
SPUTNIK_DAO_ID=your-dao.sputnik-dao.testnet
NEAR_RPC_URL=https://rpc.testnet.near.org

# Private review (the API key is never returned or logged).
NEARAI_CLOUD_API_KEY=
NEAR_AI_MODEL=zai-org/GLM-5.1-FP8
